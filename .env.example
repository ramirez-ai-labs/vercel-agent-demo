# --- AI Gateway ---
# Lets the AI SDK address models with a plain "provider/model" string.
# Create one at https://vercel.com/dashboard -> AI Gateway.
AI_GATEWAY_API_KEY=

# Optional override — defaults to anthropic/claude-sonnet-4-5 in lib code.
AI_MODEL=anthropic/claude-sonnet-4-5

# --- Vercel Sandbox ---
# Locally, the SDK can use OIDC via `vercel env pull` instead of these.
# In production (deployed on Vercel) these are usually not needed —
# the SDK picks up OIDC automatically. Set them only for local dev
# outside `vercel dev`, or CI.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
