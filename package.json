{
  "name": "sandbox-agent-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A code-generating agent that writes a script with an LLM (via Vercel AI Gateway) and runs it inside an isolated Vercel Sandbox microVM, streaming the result back to the browser.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "bash scripts/test-all.sh"
  },
  "dependencies": {
    "@vercel/sandbox": "^2.0.0",
    "ai": "^5.0.0",
    "next": "^15.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.4.0",
    "typescript": "^5.6.0",
    "vitest": "^1.0.0"
  }
}
